# Copy this file to `.env` (or `.env.local`) for local development.
#
# Base URL of the DocOnGo backend API.
# - Leave it unset to fall back to http://localhost:5000 (local backend).
# - Set it to your deployed backend to point the app at production.
#
# The value may be either the bare host (e.g. https://docongo-api.onrender.com)
# or include a trailing /api — the app normalizes both.
VITE_API_BASE=http://localhost:5000
